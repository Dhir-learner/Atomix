  reactionId: 3
  reactionName: "HCl + NaHCO3 -> NaCl + H2O + CO2"
  displayTitle: "Hydrochloric Acid + Sodium Bicarbonate"
  reactionType: 1
  activationEnergy: 45
  enthalpyChange: 31.4
  entropyChange: 241
  energyProfilePoints:
  - {x: 0, y: 0.0}
  - {x: 0.025, y: 0.0}
  - {x: 0.05, y: 0.0001}
