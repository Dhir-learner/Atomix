  reactionId: 1
  reactionName: "2Na + 2H2O -> 2NaOH + H2"
  displayTitle: "Sodium + Water"
  reactionType: 0
  activationEnergy: 10
  enthalpyChange: -368.6
  entropyChange: -15.5
  energyProfilePoints:
