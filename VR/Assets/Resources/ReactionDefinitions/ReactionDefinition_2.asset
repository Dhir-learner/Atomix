  m_Name: ReactionDefinition_2
  m_EditorClassIdentifier: 
  reactionId: 2
  displayName: "H2SO4 + CuO -> CuSO4 + H2O"
  examDisplayName: "H2SO4 + CuO -> CuSO4 + H2O [Test]"
  equation: "H2SO4 + CuO -> CuSO4 + H2O"
  kind: 0
  tolerancePercent: 8
  settleSeconds: 1.5
  enforceOrder: 1
  wrongOrderMessage: "Copper(II) oxide was tipped in before any acid was present, so there was no H2SO4 for the oxide to dissolve in."
  procedureFailureReason: ""
  procedureFailureHeadline: ""
  reagents:
  - name: "H2SO4"
    unit: "ml"
    target: 20
    flowPerSecond: 5
    tolerancePercentOverride: -1
    orderMatters: 1
    orderGroup: -1
    addition: 0
    overdoseMessage: "Excess acid creates corrosive fumes - the leftover H2SO4 has no CuO left to neutralise it."
    underdoseMessage: "Too little acid leaves most of the copper oxide undissolved, so no CuSO4 forms."
    lumpGraceSeconds: 0
    lumpOverflowPerSecond: 0
    formula: "H2SO4"
    coefficient: 1
    challengeRole: 1
  - name: "CuO"
    unit: "g"
    target: 8
    flowPerSecond: 2
    tolerancePercentOverride: -1
    orderMatters: 1
    orderGroup: -1
    addition: 0
    overdoseMessage: "Excess copper oxide simply settles out - only the acid present can be converted to CuSO4."
    underdoseMessage: "Insufficient CuO leaves unreacted acid, so the solution stays strongly acidic instead of turning blue."
    lumpGraceSeconds: 0
    lumpOverflowPerSecond: 0
    formula: "CuO"
    coefficient: 1
    challengeRole: 1
  challengeEligible: 1
  productName: "copper(II) sulfate"
  productFormula: "CuSO4"
  productCoefficient: 1
  challengeBasisReagent: "CuO"
